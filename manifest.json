{
  "schemaVersion": 1,
  "id": "sd.dottie-todo-omarchy",
  "name": "Dottie-Todos",
  "version": "0.56.0",
  "author": "sd",
  "license": "MIT",
  "description": "Omarchy bar and window app: open todos from markdown and Almanac",
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "window/TodoApp.qml"
  },
  "barWidget": {
    "displayName": "Dottie-Todos",
    "description": "Open Dottie-Todos from the Omarchy bar",
    "category": "Productivity",
    "aliases": [
      "dottie",
      "dottie-todo",
      "dottie-todos",
      "todo",
      "todos",
      "checklist"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
